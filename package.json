{
  "name": "kynex",
  "version": "0.1.0",
  "private": true,
  "description": "KYNEX — application d'entraînement multisports (monorepo).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:migrate": "npm run db:migrate -w @kynex/core",
    "db:seed:export": "npm run db:seed:export -w @kynex/core",
    "mobile": "npm run start -w @kynex/mobile"
  }
}
